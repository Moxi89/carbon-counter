# Cloudflare Pages reads this file from the output directory (static/).
# Paths are site URLs, e.g. /css/* is static/css/*.

# Security headers for every page
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'

# The embeddable counter may be framed by any site.
# This CSP is added on top of the one above; it only allows framing.
/embed
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors *

# Long cache for files whose links carry ?v= (bump it when a file changes)
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/blog/js/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
